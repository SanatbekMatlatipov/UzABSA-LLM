\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Top business domains in the multi-domain corpus (5{,}038 reviews $\to $ 23 domains). Domains explicitly named in the conference framing -- banking, retail, HoReCa -- are well represented.}}{15}{table.2}\protected@file@percent }
