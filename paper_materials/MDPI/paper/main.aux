\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces ChatML instruction template for Uzbek ABSA. The target is a single JSON list carrying \emph  {two} annotation layers, exactly as they appear in the SemEval-style source: term-level records (\textit  {ovqatlari} ``food'', \textit  {narxlari} ``prices'', each with a polarity) and category-level records (\textit  {ovqat}, \textit  {narx}, each with a polarity). The two layers are independently annotated in UzABSA and are therefore not paired into \{term, category, polarity\} triples; this study evaluates the term layer (\Cref  {sec:meth_eval}).}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:instruction_example_ui}{{1}{7}{ChatML instruction template for Uzbek ABSA. The target is a single JSON list carrying \emph {two} annotation layers, exactly as they appear in the SemEval-style source: term-level records (\textit {ovqatlari} ``food'', \textit {narxlari} ``prices'', each with a polarity) and category-level records (\textit {ovqat}, \textit {narx}, each with a polarity). The two layers are independently annotated in UzABSA and are therefore not paired into \{term, category, polarity\} triples; this study evaluates the term layer (\Cref {sec:meth_eval})}{figure.caption.4}{}}
\newlabel{fig:instruction_example_ui@cref}{{[figure][1][]1}{[1][7][]7}{}{}{}}
